{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus",
  "version": "0.1.0",
  "identifier": "com.nexus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @nexus/desktop",
    "beforeBuildCommand": "npm run build --workspace @nexus/desktop",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1459"
  },
  "app": {
    "windows": [
      {
        "title": "Nexus",
        "width": 1320,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
